PORT=3001
DATABASE_URL=./storage/jack-case.db
STORAGE_DIR=./storage/uploads
APP_ORIGIN=http://localhost:5173
# Production: set a stable value from openssl rand -hex 32.
# Development: omission persists a private key beside the database.
# SESSION_SECRET=
MAX_IMAGE_MB=10

# Generate once; persist separately from SESSION_SECRET, never commit the actual key.
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_KEY=
# Empty ignores forwarded headers; production OpenResty needs the exact loopback peer.
# In production set TRUSTED_PROXY_IPS=127.0.0.1 (see ops/AUTH-SECURITY.md).
TRUSTED_PROXY_IPS=
HOST=127.0.0.1
# Per-IP attempts per 15 minutes; per-account login 10 / register 5 are retained.
AUTH_LOGIN_IP_LIMIT=200
AUTH_REGISTER_IP_LIMIT=50
# Anonymous case preview endpoints: per-IP requests per minute.
PREVIEW_IP_LIMIT=120
