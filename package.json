{
  "name": "jack-case",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @jack-case/api\" \"npm run dev -w @jack-case/web\"",
    "build": "npm run build -w @jack-case/web && npm run build -w @jack-case/api",
    "start": "npm run start -w @jack-case/api",
    "db:generate": "drizzle-kit generate --config apps/api/drizzle.config.ts",
    "db:migrate": "npm run db:migrate -w @jack-case/api",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "demo:medical": "node scripts/import-medical-reference.mjs",
    "db:backup": "tsx apps/api/src/maintenance.ts backup",
    "db:restore": "tsx apps/api/src/maintenance.ts restore"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "daisyui": "^5.7.50",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    }
  }
}
